# Copy this file to .env and fill in real values.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: defaults to SQLite (db.sqlite3). Uncomment to use PostgreSQL.
# DATABASE_URL=postgres://user:password@localhost:5432/candleshop

# Optional: the admin's "Translate" button (English -> Armenian and Russian). Off when empty.
# TRANSLATION_PROVIDER=claude     # claude (Anthropic API; also run: pip install anthropic) or google
# TRANSLATION_API_KEY=
# TRANSLATION_MODEL=              # Claude only; defaults to claude-opus-5-5

# Recommended in production: the public address, used in the links search engines and
# link previews see (canonical address, language versions, preview images).
# SITE_URL=https://hugcrafts.am

# Production behind Apache/nginx (see deploy/SERVER.md): http -> https.
# BEHIND_PROXY=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000   # only once https works everywhere
